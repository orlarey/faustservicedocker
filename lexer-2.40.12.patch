-"\""[^\"]*"\""	return STRING;
+"\""[^\"]*"\""	{ checkString(yytext); return STRING; }
 
 "<"{LETTER}*"."{LETTER}">"	return FSTRING;
 "<"{LETTER}*">"				return FSTRING;
